{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid && newData.child('phase').val() === 'waiting' && newData.child('players').child(auth.uid).exists()",
        "host": { ".write": false },
        "createdAt": { ".write": false },
        "phase": { ".write": "auth != null && data.parent().child('host').val() === auth.uid && newData.val() === 'playing' && data.val() === 'waiting'" },
        "round": { ".write": "auth != null && data.parent().child('host').val() === auth.uid && newData.isNumber() && newData.val() === data.val() + 1" },
        "letter": { ".write": "auth != null && data.parent().child('host').val() === auth.uid && newData.isString() && newData.val().length <= 2" },
        "endsAt": { ".write": "auth != null && data.parent().child('host').val() === auth.uid && newData.isNumber() && newData.val() > now && newData.val() < now + 180000" },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms').child($room).child('phase').val() === 'waiting')",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 25"
          }
        },
        "$other": { ".write": false }
      }
    },
    "submissions": {
      "$room": {
        "$round": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($room).child('players').child($uid).exists() && root.child('rooms').child($room).child('phase').val() === 'playing' && now <= root.child('rooms').child($room).child('endsAt').val() + 3000",
            ".validate": "newData.hasChildren(['answers', 'submittedAt']) && newData.child('answers').hasChildren(['اسم','حيوان','نبات','جماد','بلاد'])"
          }
        }
      }
    }
  }
}