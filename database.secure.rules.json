{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": false,
        "host": {
          ".write": false
        },
        "phase": {
          ".write": false
        },
        "round": {
          ".write": false
        },
        "letter": {
          ".write": false
        },
        "endsAt": {
          ".write": false
        },
        "totals": {
          ".write": false
        },
        "roundScores": {
          ".write": false
        },
        "lastScoredRound": {
          ".write": false
        },
        "usedLetters": {
          ".write": false
        },
        "players": {
          "$uid": {
            ".write": false,
            ".validate": "newData.hasChildren(['name','joinedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 25"
          }
        },
        "literary": {
          ".write": false
        },
        "literaryScores": {
          ".write": false
        },
        "literaryRound": {
          ".write": false
        },
        "literaryUsed": {
          ".write": false
        }
      }
    },
    "submissions": {
      "$room": {
        "$round": {
          "$uid": {
            ".read": false,
            ".write": false
          }
        }
      }
    },
    "reviews": {
      "$room": {
        "$round": {
          ".read": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && root.child('rooms').child($room).child('phase').val() !== 'playing'",
          ".write": false
        }
      }
    },
    "ballots": {
      "$room": {
        "$round": {
          ".read": false,
          ".write": false
        }
      }
    },
    "candidateAnswers": {
      "$candidate": {
        ".read": false,
        ".write": false
      }
    },
    "approvedAnswers": {
      "$candidate": {
        ".read": false,
        ".write": false
      }
    },
    "literaryBallots": {
      "$room": {
        ".read": false,
        ".write": false
      }
    },
    "requestThrottle": {
      ".read": false,
      ".write": false
    }
  }
}
